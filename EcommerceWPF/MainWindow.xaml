<Window x:Class="ECommerceWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-Commerce Order Management System" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <TextBlock Text="E-COMMERCE ORDER MANAGEMENT SYSTEM" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border Grid.Column="0" Background="#ECF0F1" Margin="0,0,10,0" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="LOGIN" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="Email:"/>
                    <TextBox x:Name="txtEmail" Margin="0,2,0,5"/>

                    <TextBlock Text="Password:"/>
                    <PasswordBox x:Name="txtPassword" Margin="0,2,0,5"/>

                    <ComboBox x:Name="cmbRole" Margin="0,5,0,5" SelectedIndex="0">
                        <ComboBoxItem Content="Customer"/>
                        <ComboBoxItem Content="Admin"/>
                    </ComboBox>

                    <Button x:Name="btnLogin" Content="Login" Background="#27AE60" 
                            Foreground="White" Height="30" Click="BtnLogin_Click" Margin="0,5"/>

                    <Button x:Name="btnSignUp" Content="Sign Up (New Customer)" 
                            Background="#3498DB" Foreground="White" Height="30"
                            Click="BtnSignUp_Click" Margin="0,5"/>

                    <TextBlock x:Name="lblUserName" Text="Not logged in" 
                               FontWeight="Bold" Margin="0,15,0,5"/>

                    <Button x:Name="btnLogout" Content="Logout" Background="#95A5A6" 
                            Foreground="White" Height="30" Click="BtnLogout_Click" 
                            IsEnabled="False" Margin="0,5,0,0"/>

                    <Border Background="#2C3E50" Padding="5" Margin="0,15,0,5" CornerRadius="3">
                        <TextBlock x:Name="lblMenuTitle" Text="MENU" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel x:Name="menuPanel" Visibility="Collapsed">
                        <!-- Customer Menu -->
                        <StackPanel x:Name="customerMenu" Visibility="Collapsed">
                            <Button Content="1. Browse Products" Click="BtnBrowseProducts_Click" Margin="0,3"/>
                            <Button Content="2. Search by Category" Click="BtnSearchCategory_Click" Margin="0,3"/>
                            <Button Content="3. Add to Cart" Click="BtnAddToCart_Click" Margin="0,3"/>
                            <Button Content="4. View Cart" Click="BtnViewCart_Click" Margin="0,3"/>
                            <Button Content="5. Place Order" Click="BtnPlaceOrder_Click" Margin="0,3"/>
                            <Button Content="6. My Orders" Click="BtnMyOrders_Click" Margin="0,3"/>
                            <Button Content="7. Make Payment" Click="BtnMakePayment_Click" Margin="0,3"/>
                            <Button Content="8. Track Shipment" Click="BtnTrackShipment_Click" Margin="0,3"/>
                            <Button Content="9. Write Review" Click="BtnWriteReview_Click" Margin="0,3"/>
                            <Button Content="10. My Profile" Click="BtnMyProfile_Click" Margin="0,3"/>
                        </StackPanel>

                        <!-- Admin Menu -->
                        <StackPanel x:Name="adminMenu" Visibility="Collapsed">
                            <Button Content="1. View All Products" Click="BtnAdminViewProducts_Click" Margin="0,3"/>
                            <Button Content="2. Add Product" Click="BtnAdminAddProduct_Click" Margin="0,3"/>
                            <Button Content="3. Edit Product" Click="BtnAdminEditProduct_Click" Margin="0,3"/>
                            <Button Content="4. Delete Product" Click="BtnAdminDeleteProduct_Click" Margin="0,3"/>
                            <Button Content="5. View Categories" Click="BtnAdminViewCategories_Click" Margin="0,3"/>
                            <Button Content="6. View All Orders" Click="BtnAdminViewOrders_Click" Margin="0,3"/>
                            <Button Content="7. Update Order Status" Click="BtnAdminUpdateOrder_Click" Margin="0,3"/>
                            <Button Content="8. View All Customers" Click="BtnAdminViewCustomers_Click" Margin="0,3"/>
                            <Button Content="9. Manage Customer Status" Click="BtnAdminToggleCustomer_Click" Margin="0,3"/>
                            <Button Content="10. Sales Report" Click="BtnAdminSalesReport_Click" Margin="0,3"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Panel -->
            <Border Grid.Column="1" Background="White" Padding="10" CornerRadius="5" BorderBrush="#BDC3C7" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#34495E" Padding="5" CornerRadius="3" Margin="0,0,0,10">
                        <TextBlock x:Name="lblPanelTitle" Text="Welcome" Foreground="White" FontWeight="Bold"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="contentPanel">
                            <DataGrid x:Name="dataGrid" AutoGenerateColumns="True" 
                                      Margin="0,0,0,10" MaxHeight="400"/>
                            <TextBlock x:Name="lblMessage" TextWrapping="Wrap" Margin="0,5"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2C3E50" Padding="5">
            <TextBlock Text="E-Commerce Order Management System" 
                       Foreground="#7F8C8D" HorizontalAlignment="Center" FontSize="10"/>
        </Border>
    </Grid>
</Window>